# Local development defaults only. Copy to .env and keep .env out of Git.
DJANGO_SETTINGS_MODULE=django_employee_qr.settings
DJANGO_DEBUG=True
SECRET_KEY=replace-with-a-long-random-development-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
ATTENDANCE_LATE_AFTER=09:00

# Optional kiosk network allow-list. Leave blank for local testing.
WORKTRACK_KIOSK_IP_RANGES=
# Trust forwarded client addresses only from explicitly trusted reverse proxies.
WORKTRACK_TRUSTED_PROXY_IPS=127.0.0.1/32,::1/128

# Demo email is written to the terminal; no message is delivered.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@worktrack.local
WORKTRACK_HR_EMAILS=

# Production-only settings. Use django_employee_qr.production_settings on EC2.
# Never put real credentials in this file or commit a populated .env.
DB_NAME=worktrack
DB_USER=replace-with-rds-app-user
DB_PASSWORD=replace-with-rds-app-password
DB_HOST=replace-with-rds-endpoint
DB_PORT=5432
DB_SSLMODE=require
DB_SECRET_ARN=
AWS_STORAGE_BUCKET_NAME=replace-with-private-s3-bucket
AWS_REGION=ap-southeast-1
AWS_SES_FROM_EMAIL=
