[Unit]
Description=WorkTrack Django application
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/worktrack/app
EnvironmentFile=/etc/worktrack/worktrack.env
ExecStart=/opt/worktrack/venv/bin/gunicorn --workers 2 --timeout 120 --bind 127.0.0.1:8000 django_employee_qr.wsgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
